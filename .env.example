# Copy to .env to override defaults used by docker-compose.yml. Everything here is optional.
JWT_SECRET=change-me-to-a-long-random-string-0123456789abcdef
PRODUCT_NAME=Матрица
# Networks whose X-Forwarded-For the API believes (the reverse proxy). Default: loopback and private ranges.
# TRUSTED_PROXIES=10.0.0.0/8
# AI assistant on an open-weights model (see README, section "ИИ"):
AI_ENABLED=false
OLLAMA_MODEL=hf.co/t-tech/T-lite-it-2.1-GGUF:Q4_K_M
# On a Mac the model is much faster on the host than in Docker (no GPU in containers):
# run `ollama serve` on the host and point the API at it:
# OLLAMA_URL=http://host.docker.internal:11434
